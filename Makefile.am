# Xsdl: an X server that renders into an SDL2 window, for macOS.
# The sources are xorg-server's, limited to what the kdrive Xsdl server needs.

ACLOCAL_AMFLAGS = -I m4

bin_PROGRAMS = Xsdl

AM_CPPFLAGS = \
	-DHAVE_DIX_CONFIG_H \
	-DCLIENTIDS \
	-I$(top_builddir)/include \
